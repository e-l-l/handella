# Copy to .env and run: chmod 600 .env
HANDELLA_PORT=4310
HANDELLA_DATABASE_PATH=.data/handella.sqlite

# Optional. A Linear personal API key turns on intake and ad hoc issue creation.
# Without it Handella still starts and the dashboard shows a setup notice.
# HANDELLA_LINEAR_API_KEY=lin_api_...

# Optional. Which application "Open session" resumes a job's Codex session in,
# and which "Open terminal" opens its worktree in before it has one.
# Unset takes the first of Ghostty, iTerm and Terminal that is installed.
# HANDELLA_TERMINAL_APP=Ghostty
